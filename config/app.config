# ═══════════════════════════════════════════════════════════
# app.config — Reservation Desk Configuration
# ═══════════════════════════════════════════════════════════
# This file is read by DBConnection.java using BufferedReader
# (SYLLABUS: Advanced File I/O — BufferedReader).
#
# Lines starting with '#' are treated as comments.
# Format: key=value (no spaces around '=').
# ═══════════════════════════════════════════════════════════

# Path to the SQLite database file (relative to project root)
db.path=reservation_desk.db

# Seat lock timeout in seconds (how long a seat stays YELLOW)
lock.timeout.seconds=60

# Seat grid dimensions (rows × cols = total seats per vehicle)
grid.rows=6
grid.cols=5

# Number of simulated concurrent booking agents
sim.agents=3
